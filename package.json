{
  "name": "@microsoft/microsoft.aspnetcore.components.web.js",
  "private": true,
  "version": "0.0.1",
  "description": "Standalone static SSR-focused Blazor JavaScript runtime extraction.",
  "main": "index.js",
  "sideEffects": [
    "GlobalExports.*",
    "MonoPlatform.*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "lint": "eslint -c ./src/.eslintrc.js src/Boot.Ssr.ts src/Services/SsrEventRegistry.ts src/Rendering/ScrollRestoration.ts src/Rendering/DomSynchronizer.ts src/Rendering/SsrDomMerging/*.ts src/BuildStubs/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --nolazy --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --colors --verbose",
    "build": "npm run build:debug && npm run build:production",
    "build:debug": "rollup -c --environment NODE_ENV:development",
    "build:production": "rollup -c --environment NODE_ENV:production",
    "verify:toolchain": "npm run build && npm test && npm run lint && npm run check:ssr-boundary",
    "check:ssr-boundary": "node scripts/check-ssr-boundary.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/jsdom": "^16.2.15",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-header": "^3.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  }
}
